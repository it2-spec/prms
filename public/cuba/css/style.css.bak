.framework-box {
  position: relative;
  margin-left: 30px;
  display: flex;
  align-items: center;
  gap: 1rem;
  border-radius: 50px 16px 16px 50px;
  border-width: 2px;
  border-style: solid;
  border-color: rgba(var(--white),1);
  --tw-bg-opacity: 1;
  background-color: rgb(252 252 253 / var(--tw-bg-opacity, 1));
  padding-left: 1rem;
  padding-right: 1rem;
  padding-top: 18px;
  padding-bottom: 18px;
  --tw-shadow: 0px 5px 20px rgba(46,35,94,0.12);
  --tw-shadow-colored: 0px 5px 20px var(--tw-shadow-color);
  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);
  transition-property: all;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
  transition-duration: 0.5s;
}

.framework-box::after {
  position: absolute;
  right: -1px;
  top: -1px;
  bottom: 0px;
  height: calc(100% + 4px);
  width: 2.5rem;
  border-radius: 10px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-style: dashed;
  border-top-color: rgba(0,2,72,0.2);
  border-bottom-color: rgba(0,2,72,0.2);
  border-right-color: rgba(0,2,72,0.2);
  --tw-content: "";
  content: var(--tw-content);
}

