    &.border-left-primary {
      border-style: solid;
    }
    &.border-left-primary {
      border-left-color: rgba(var(--theme-default),1);
    }
    &.border-left-primary {
      [dir="rtl"] & {
        border-left-width: 0px;
      }
      [dir="rtl"] & {
        border-right-width: 4px;
      }
      [dir="rtl"] & {
        border-style: solid;
      }
