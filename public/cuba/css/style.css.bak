.smooth-animate {
  &:hover {
    .label {
      padding-left: 1em;
    }
  }
  .media-image {
    position: relative;
  }
  .media-image {
    display: inline-block;
  }
  .media-image {
    width: auto;
  }
  .media-image {
    img {
      display: block;
