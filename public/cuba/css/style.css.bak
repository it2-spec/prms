      padding-right: 5px;
    }
    span {
      font-size: 2.25rem;
      line-height: 2.5rem;
    }
    span {
      font-weight: 500;
    }
  }
  &.blog-shadow {
    @media (max-width: 575px) {
       {
         {
           {
            > &:before {
              width: 90%;
            }
          }
        }
      }

       {
         {
           {
             {
              > &:before {
                width: 90%;
              }
            }
          }
        }
      }
    }
    @media (max-width: 575px) {
       {
