.pulse-wrapper {
  a {
    border-radius: 50%;
  }
  svg {
    border-radius: 50%;
  }
  svg {
    animation: pulse-animate 1s infinite ease;
  }
  i {
    animation: pulse-animate 1s infinite ease;
  }
  @keyframes pulse-animate {
    0% {
      box-shadow: 0 0 0 0px rgba(0, 0, 0, 0.1);
    }

    100% {
      box-shadow: 0 0 0 20px rgba(0, 0, 0, 0);
    }
  }
}

.heartbeat-wrapper {
  a {
    border-radius: 50%;
  }
  svg {
    border-radius: 50%;
  }
  svg {
    stroke: rgba(var(--danger-color),1);
  }
  svg {
    animation: heartbeat-rate 1s infinite ease;
  }
  i {
    color: rgba(var(--danger-color),1);
  }
  i {
    animation: heartbeat-rate 1s infinite ease;
  }
}

.custom-border-pulse-wrapper {
  a {
    border-width: 4px !important;
  }
  a {
    border-width: 4px;
  }
  a {
    border-style: double;
  }
  a {
    border-color: rgba(var(--recent-dashed-border),1);
  }
  a {
    border-radius: unset;
    svg,
      i {
      border-radius: 1%;
    }
  }
}

.pulse-rhombus {
  a {
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }
  svg,
    i {
    border-radius: 0px;
  }
}

.pulse-rabbet {
  a {
    clip-path: polygon(
        0% 15%,
        15% 15%,
        15% 0%,
        85% 0%,
        85% 15%,
        100% 15%,
        100% 85%,
        85% 85%,
        85% 100%,
        15% 100%,
        15% 85%,
        0% 85%
      );
  }
}

@keyframes heartbeat-rate {
  0% {
    transform: scale(1);
    opacity: 1;
  }

  15% {
    transform: scale(0.8);
  }

  20% {
    transform: scale(0.85);
    opacity: 1;
  }

  35% {
    transform: scale(1.3);
    opacity: 0.6;
  }

  50% {
    transform: scale(1);
    opacity: 1;
  }

  100% {
    transform: scale(1);
  }
}

