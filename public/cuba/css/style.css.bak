  .landing-title {
    margin-bottom: 30px !important;
  }
}

html[dir="rtl"] {
  ul {
    padding-right: 0px;
  }
  .dt-buttons {
    .dt-button {
      &:first-child {
        border-radius: 0 6px 6px 0 !important;
      }
      &:last-child {
        border-radius: 6px 0 0 6px !important;
      }
      + .dt-button {
        border-right-width: 0px;
      }
      + .dt-button {
        border-left-width: 1px;
      }
      + .dt-button {
