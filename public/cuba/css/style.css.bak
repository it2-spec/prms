      .blog-social {
        li {
          padding-top: 0 !important;
          padding-bottom: 0 !important;
        }
        li {
          padding-left: 0.75rem;
          padding-right: 0.75rem;
        }
        li {
          padding-top: 0px;
          padding-bottom: 0px;
        }
      }
    }
    .blog-details {
      .blog-social {
        li {
          &:first-child {
            padding-right: 25px;
          }
          &:first-child {
            [dir="rtl"] & {
              padding-left: 25px;
            }
            [dir="rtl"] & {
              padding-right: unset;
            }
          }
          + li {
            padding-left: 25px;
          }
          + li {
            [dir="rtl"] & {
              padding-left: unset;
            }
            [dir="rtl"] & {
              padding-right: 25px;
            }
          }
        }
      }
    }
  }

  .blog-single {
    .blog-box {
      .blog-details {
        .blog-social {
          li {
            &:first-child {
              padding-right: 0.75rem;
            }
            &:first-child {
              [dir="rtl"] & {
                padding-left: 0.75rem;
              }
              [dir="rtl"] & {
                padding-right: unset;
              }
            }
            + li {
              padding-left: 0.75rem;
            }
            + li {
              [dir="rtl"] & {
                margin: 0px !important;
              }
              [dir="rtl"] & {
                margin: 0px;
              }
              [dir="rtl"] & {
                padding-left: 0px;
              }
              [dir="rtl"] & {
                padding-right: 0.75rem;
              }
            }
          }
        }
      }
    }
  }

  .footer-copyright {
    ~ div {
      text-align: center;
    }
    @media (max-width: 767px) {
       {
        ~ div {
        }
      }
    }
    ~ div {
      text-align: center;
    }
    ~ div {
      p {
        float: none;
      }
      p {
        margin-top: 5px;
      }
    }
  }

  .tabs-social {
    &.border-tab {
      @media (min-width: 1200px) {
         {
           {
             {
