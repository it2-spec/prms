          right: -75px !important;
        }
        .date {
          left: unset !important;
        }
      }
      .icon {
        right: 3.5rem;
      }
      .icon {
        left: unset;
      }
      &.right {
        left: unset;
      }
      &.right {
        right: 50%;
      }
      &.right::before {
        content: var(--tw-content);
        left: unset;
      }
      &.right::before {
        content: var(--tw-content);
        right: 0.5rem;
      }
      &.right::after {
        content: var(--tw-content);
        left: unset;
      }
      &.right::after {
        content: var(--tw-content);
        right: -0.5rem;
      }
      &.right {
        .date {
          right: -75px;
        }
        .date {
          left: unset;
        }
        .icon {
          left: unset;
        }
        .icon {
