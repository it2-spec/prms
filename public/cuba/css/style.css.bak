@media (max-width: 1199px) and (min-width: 992px) {
  .page-wrapper {
    &.horizontal-wrapper {
      &.material-type {
        .page-header {
          max-width: 930px;
        }
        .page-body-wrapper {
          .sidebar-wrapper,
            .page-body {
            max-width: 930px;
          }
        }
      }
    }
  }
}

