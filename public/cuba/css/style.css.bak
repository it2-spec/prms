  .page-body {
    transition-property: 0.5s;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }
  .page-body::before {
    content: var(--tw-content);
    animation: fadeIn 0.5s ease-in-out;
  }
  .page-title {
    margin-top: 0 !important;
  }
