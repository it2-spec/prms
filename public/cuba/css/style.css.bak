    }
    &.border-left-secondary {
      [dir="rtl"] & {
        border-left-width: 0px;
      }
      [dir="rtl"] & {
        border-right-width: 4px;
      }
      [dir="rtl"] & {
        border-style: solid;
      }
      [dir="rtl"] & {
