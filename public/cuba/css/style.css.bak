    padding-right: 13px;
  }
  .close {
    opacity: 0.5;
  }
  .close {
    transition-property: all;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }
  .close {
    transition-duration: 0.3s;
  }
  .close {
    transition-timing-function: ease;
  }
  .close:hover {
    color: inherit;
  }
  .close:hover {
    opacity: 1;
  }
  .close:hover {
    transition-property: all;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }
  .close:hover {
    transition-duration: 0.3s;
  }
  .close:hover {
    transition-timing-function: ease;
  }
