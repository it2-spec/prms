@media (max-width: 991px) and (min-width: 768px) {
  .page-wrapper {
    &.compact-wrapper {
      &.material-type {
        &::before {
          height: 230px;
        }
        .page-header {
          margin-bottom: 0 !important;
        }
        .page-header {
          margin-left: auto;
          margin-right: auto;
        }
        .page-header {
          margin-top: 50px;
        }
        .page-header {
          margin-bottom: 0px;
        }
        .page-header {
          width: calc(100% - 60px);
        }
        .page-body-wrapper {
          margin-left: 30px;
          margin-right: 30px;
        }
        .page-body-wrapper {
          margin-top: 0px;
          margin-bottom: 0px;
        }
        .page-body-wrapper {
          div.sidebar-wrapper {
            left: 0px;
          }
          .page-body {
            margin-top: 0 !important;
          }
          .page-body {
            margin-top: 0px;
          }
        }
      }
    }
  }
}

