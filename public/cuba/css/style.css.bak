          var(--info-color)
        );
      font-variant: small-caps;
    }
  }
}

@keyframes grow {
  0% {
    transform: scale(0.5);
    background: var(--info-color);
  }

  50% {
    transform: scale(1);
    background: var(--theme-secondary);
  }
}

@keyframes move {
  0% {
    transform: translateX(7em);
  }

  50% {
    transform: translateX(-5em);
  }
}

@keyframes shrink {
  0% {
    transform: translateX(0em);
  }

  50% {
    transform: translateX(-1em);
  }
}

