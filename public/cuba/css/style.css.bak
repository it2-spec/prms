                    }
                  }
                }
                &.dt-orderable-asc,
                  &.dt-ordering-asc {
                  span {
                    &.dt-column-order {
                      &::before {
                        display: block;
                      }
                      &::before {
                        position: absolute;
                      }
                      &::before {
                        bottom: 50%;
                      }
                      &::before {
                        display: block;
                      }
                      &::before {
                        --tw-content: "▲";
                        content: var(--tw-content);
                      }
                      &::before {
                        --tw-content: "▲" /"";
                        content: var(--tw-content);
                      }
                    }
                  }
                }
                &.dt-orderable-desc,
                  &.dt-ordering-desc {
