@media (max-width: 991px) {
  .customer-wrapper {
    padding: 0 !important;
    padding: 0px;
    .customer-box {
      padding-left: 12px !important;
      padding-right: 12px !important;
    }
    .outline-box {
      display: none !important;
    }
  }

  .landing-page {
    .container {
      max-width: 720px !important;
    }
    .container {
      padding-left: 15px;
      padding-right: 15px;
    }
  }

  .ptb50 {
    padding-left: 0 !important;
    padding-right: 0 !important;
    padding-left: 0px;
    padding-right: 0px;
    padding-top: 60px;
    padding-bottom: 60px;
  }

  .build-section {
    .landing-title {
      @media (max-width: 575px) {
         {
