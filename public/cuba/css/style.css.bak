  color: rgba(var(--white),1);
  &:hover {
    color: rgb(var(--white),1) !important;
  }
  &:hover {
    --tw-text-opacity: 1;
    color: rgb(255 255 255 / var(--tw-text-opacity, 1));
  }
}

.bg-secondary {
  background-color: rgba(var(--theme-secondary),1) !important;
