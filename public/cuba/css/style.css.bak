.loading-card-wrapper {
  img {
    height: calc(125px + (200 - 125) * ((100vw - 320px) / (1920 - 320)));
  }
  img {
    -o-object-fit: cover;
       object-fit: cover;
  }
}

.placeholder.table {
  white-space: pre-wrap !important;
}

.placeholder {
  display: inline-block;
  min-height: 1em;
  cursor: wait;
  vertical-align: middle;
  opacity: 0.5;
}

