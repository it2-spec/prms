@media (max-width: 480px) {
  .sticky-header header.sticky {
    height: 3.5rem;
  }

  header.sticky {
    .navbar-expand-xl {
      .navbar-collapse {
        top: 2.25rem;
      }
    }
  }

  .landing-home {
    .sticky-header header .nav-padding {
      padding: 15px;
    }
    .navbar-toggler {
      padding: 0 !important;
    }
    .navbar-toggler {
      border-color: none;
    }
    .navbar-toggler {
      background-color: transparent;
    }
    .navbar-toggler {
      padding: 0px;
    }
    .navbar-brand img {
      height: 25px;
    }
  }
}

