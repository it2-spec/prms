@media (max-width: 360px) {
  .mail-body-wrapper {
    .user-mail-wrapper {
      .user-title {
        justify-content: unset;
        align-items: unset;
      }
    }
  }

  .main-upgrade {
    .variation-box {
      grid-template-columns: unset;
    }
  }

  .language-header {
    padding-bottom: 60px !important;
  }

  .main {
    .langChoice {
      left: 0;
    }
    .langChoice {
      top: 50px;
    }
    .langChoice {
      right: 20px;
    }
    .langChoice {
      margin-left: auto;
    }
    .langChoice {
      width: 30%;
    }
  }

  .popover {
    width: 255px;
  }

  .main-divider {
    .common-align {
      .vr {
        margin-left: 16px;
      }
      .vr {
        margin-right: 17px;
      }
    }
  }

  .login-card {
    .login-main {
      &.create-account {
        .theme-form {
          .or {
            &::before {
              width: 22%;
            }
          }
        }
      }
    }
  }

  .browse {
    .browse-articles {
      ul {
        li {
          a {
            span {
              &:nth-child(2) {
                display: block;
              }
              &:nth-child(2) {
                margin-left: auto;
                margin-right: auto;
              }
              &:nth-child(2) {
                margin-top: 0px;
                margin-bottom: 0px;
              }
              &:nth-child(2) {
                display: block;
              }
              &:nth-child(2) {
                max-width: 100%;
              }
              &:nth-child(2) {
                overflow: hidden;
              }
              &:nth-child(2) {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
              }
              &:nth-child(2) {
                margin-left: 0;
                margin-right: 0;
              }
              &:nth-child(2) {
                display: inline-block;
              }
              &:nth-child(2) {
                width: 158px;
              }
              &:nth-child(2) {
                overflow: hidden;
              }
              &:nth-child(2) {
                text-overflow: ellipsis;
              }
              &:nth-child(2) {
                white-space: nowrap;
              }
            }
          }
        }
      }
    }
  }

  .modal {
    .modal-header {
      .product-box {
        .product-details {
          .product-qnty {
