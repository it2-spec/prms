        padding-right: 30px;
      }
    }
  }

  .animated-timeline {
    .timeline-block {
      &::before {
        left: 18px;
      }
      .title {
        text-align: left;
      }
      .timeline-event {
        &:nth-child(odd) {
          margin-left: 58px !important;
        }
        &:nth-child(even) {
          margin-left: 58px !important;
        }
        &:nth-child(even) {
          &:before {
            left: unset;
          }
          &:before {
            right: calc(100% + 33px);
          }
        }
        &::before {
          left: -47px !important;
        }
      }
    }
  }

