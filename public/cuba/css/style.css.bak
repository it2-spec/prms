        font-size: 1rem;
        line-height: 1.5rem;
      }
    }
    .navbar-expand-lg {
      .navbar-toggler {
        background-color: rgba(var(--white),1);
      }
      .navbar-toggler {
        .navbar-toggler-icon {
          i {
            margin-top: 5px;
          }
          i {
            color: rgba(var(--theme-default),1);
          }
        }
      }
      .navbar-collapse {
        .navbar-nav {
          .nav-item {
            a {
              color: rgba(var(--black),1);
            }
          }
        }
      }
    }
    .footer-bg {
      h2 {
        font-size: 28px;
      }
    }
  }

