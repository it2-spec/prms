.dataTables_wrapper {
  padding: 0 !important;
  width: calc(100% - 1px);
  padding: 0px;
  &.no-footer {
    .dataTables_scrollBody {
      border-bottom-width: 1px;
    }
    .dataTables_scrollBody {
