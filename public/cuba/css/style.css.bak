@media (max-width: 767px) {
  .landing-page {
    .container {
      max-width: 540px !important;
    }
    .container {
      padding-left: 15px;
      padding-right: 15px;
    }
  }

  .build-section {
    .landing-title {
      .title-img {
        width: 5rem;
      }
    }
    .rotate-title {
      width: 42%;
    }
    .build-image {
      @media (max-width: 575px) {
         {
           {
             {
              > img {
                width: 90%;
              }
            }
          }
        }

         {
           {
             {
               {
                > img {
                  width: 90%;
                }
              }
            }
          }
        }
      }
      @media (max-width: 575px) {
         {
           {
             {
              > img {
                width: 90%;
              }
            }
          }
        }

         {
           {
             {
               {
                > img {
                  width: 90%;
                }
              }
            }
          }
        }
      }
      img {
        width: 100%;
      }
    }
  }

  .landing-home {
    .content {
      @media (max-width: 575px) {
         {
           {
             {
              > p {
                width: 90%;
              }
            }
          }
        }

         {
           {
             {
               {
                > p {
                  width: 90%;
                }
              }
            }
          }
        }
      }
      @media (max-width: 575px) {
         {
           {
             {
