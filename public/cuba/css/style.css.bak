  .frame-tab li .tab-link {
    padding-left: 25px;
    padding-right: 25px;
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .customer-wrap {
    margin-left: -0.625rem;
    margin-right: -0.625rem;
    margin-top: 0px;
