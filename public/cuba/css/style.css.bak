/* tooltip css start */

.tooltip {
  &.bs-tooltip-top {
    .tooltip-arrow {
      &:before {
        border-top-color: rgba(var(--theme-medium-color),1);
      }
    }
  }
  &.bs-tooltip-bottom {
    .tooltip-arrow {
      &:before {
        border-bottom-color: rgba(var(--theme-medium-color),1);
      }
      &:before {
        border-top-color: transparent;
      }
    }
  }
  &.bs-tooltip-start {
    .tooltip-arrow {
      &:before {
        border-left-color: rgba(var(--theme-medium-color),1);
      }
      &:before {
        border-top-color: transparent;
      }
