@media (max-width: 575px) {
  .animated-timeline {
    .timeline-block {
      .timeline-event {
        width: auto;
      }
    }
  }

  .main-timeline {
    ul {
      li {
        > .w-full {
          width: 90%;
        }
      }
    }
  }

  .square-timeline {
    .timeline-event {
      .timeline-event-wrapper {
        width: 85%;
      }
    }
  }

  .timeline-event-wrapper {
    .f-light {
      .list-group {
        .list-group-item {
          > div {
            .timeline-icon {
              display: none;
            }
          }
        }
      }
    }
  }

  .notification {
    .dark-timeline {
      ul {
        li {
          > .w-full {
            width: 90%;
          }
        }
      }
    }
  }

