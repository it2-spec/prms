            -webkit-animation: toggle 0.8s linear forwards;
          }
        }
      }
    }
  }
  li {
    &.sad {
      --step-1-rx: 20deg;
      --step-1-ry: -12deg;
      --step-2-rx: -18deg;
      --step-2-ry: 14deg;
      div {
