.small-progressbar {
  position: relative;
  overflow: visible;
}

.small-progressbar::after {
  position: absolute;
  right: -9px;
  top: -0.125rem;
  height: 0.75rem;
  width: 0.75rem;
  border-radius: 100%;
  background-color: rgba(var(--theme-default),1);
  --tw-content: "";
  content: var(--tw-content);
}

.small-progressbar {
  [dir="rtl"] &::after {
    left: -9px;
  }
  [dir="rtl"] &::after {
    right: unset;
  }
  .progress-label {
    position: absolute;
  }
  .progress-label {
    top: -26px;
  }
  .progress-label {
    right: -0.375rem;
  }
  .progress-label {
    font-weight: 700;
  }
  .progress-label {
    [dir="rtl"] & {
      left: -0.375rem;
    }
    [dir="rtl"] & {
      right: unset;
    }
  }
  .animate-circle {
    position: absolute;
  }
  .animate-circle {
    top: -11px;
  }
  .animate-circle {
    right: -18px;
  }
  .animate-circle {
    height: 30px;
  }
  .animate-circle {
    width: 30px;
  }
  .animate-circle {
    border-radius: 70px;
  }
  .animate-circle {
    border-width: 14px;
  }
  .animate-circle {
    border-style: solid;
  }
  .animate-circle {
    border-color: rgba(var(--theme-default),0.1);
  }
  .animate-circle {
    animation: heart 1s ease-in-out linear infinite;
    [dir="rtl"] & {
      left: -18px;
    }
    [dir="rtl"] & {
      right: unset;
    }
  }
}

