      box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);
    }
  }
}

.switch-state {
  position: absolute;
  inset: 0px;
  cursor: pointer;
  border-radius: 20px;
  background-color: rgba(var(--light-color),1);
  transition: 0.4s;
  &:before {
    position: absolute;
