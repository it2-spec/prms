/*  Emoji expression rating */

.rating_expression {
  .emoji {
    animation: fade-slide-in 0.6s ease-out;
  }
  .emoji__face {
    margin-top: 0 !important;
  }
  .emoji__face {
    position: relative;
  }
  .emoji__face {
    margin-left: auto;
    margin-right: auto;
  }
  .emoji__face {
    margin-top: 0px;
  }
  .emoji__face {
    margin-bottom: 1.5rem;
  }
  .emoji__face {
    height: 42px;
  }
  .emoji__face {
    width: 42px;
  }
  .emoji__face {
    border-radius: 50%;
  }
  .emoji__face {
    background-image: linear-gradient( 135deg,hsl(var(--face-hue1),90%,55%),hsl(var(--face-hue2),90%,45%) );
  }
  .emoji__face {
