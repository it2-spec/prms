        width: 120px;
      }
    }
    .rotate-title {
      width: 30%;
    }
    .build-image {
      img {
        width: calc(100% + 100px);
      }
    }
  }

  .landing-home {
    .content-title {
      .arrow-decore {
        left: -125px;
      }
      .arrow-decore {
        top: -0.875rem;
      }
