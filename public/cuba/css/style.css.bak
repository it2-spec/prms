      .card-header {
        .header-top {
          margin-left: unset;
        }
        .header-top {
          margin-right: 74px;
        }
      }
    }
    div.dt-container {
      .dt-layout-row {
        .dt-length {
          left: unset;
        }
        .dt-length {
          right: 1.25rem;
        }
        .dataTable {
          thead {
            tr {
              th {
                text-align: right;
              }
              th {
                &:not(:first-child) {
                  padding-left: 1.75rem;
                }
              }
            }
          }
          &.table-sm {
            thead {
              tr {
                th {
                  &.dt-orderable-asc,
                    &.dt-orderable-desc,
                    &.dt-ordering-asc,
                    &.dt-ordering-desc {
                    padding-left: 1.25rem;
                  }
                  &.dt-orderable-asc,
                    &.dt-orderable-desc,
                    &.dt-ordering-asc,
                    &.dt-ordering-desc {
                    span {
                      &.dt-column-order {
                        left: 5px;
                      }
                      &.dt-column-order {
                        right: unset;
                      }
                    }
                  }
                }
              }
            }
          }
          thead {
            tr {
              th {
                &.dt-orderable-asc,
                  &.dt-orderable-desc,
                  &.dt-ordering-asc,
                  &.dt-ordering-desc {
                  padding-left: 1.75rem;
                }
                &.dt-orderable-asc,
                  &.dt-orderable-desc,
                  &.dt-ordering-asc,
                  &.dt-ordering-desc {
                  padding-right: 0.625rem;
                }
                &.dt-orderable-asc,
                  &.dt-orderable-desc,
                  &.dt-ordering-asc,
                  &.dt-ordering-desc {
                  span {
                    &.dt-column-order {
                      left: 0.75rem;
                    }
                    &.dt-column-order {
                      right: unset;
                    }
                    &.dt-column-order {
                      &::before,
                        &::after {
                        left: unset;
                      }
                      &::before,
                        &::after {
                        right: 0px;
                      }
                    }
                  }
                }
              }
            }
          }
        }
        .dt-layout-cell {
          .dt-search {
            left: -24px;
          }
          .dt-search {
            right: unset;
          }
          .dt-search {
            label {
              margin-left: 0.375rem;
            }
            label {
              margin-right: unset;
            }
          }
        }
        .dt-paging {
          text-align: start;
        }
        .dt-paging {
          .dt-paging-button {
            margin-left: 0.75rem;
          }
          .dt-paging-button {
            margin-right: unset;
          }
          .dt-paging-button {
            &:last-child {
              margin-left: 0px;
            }
            &:last-child {
              margin-right: unset;
            }
          }
        }
        .dt-select {
          .dt-select-checkbox {
            &:indeterminate {
              &::after {
                left: unset;
              }
              &::after {
                right: 0.25rem;
              }
            }
            &:checked {
              &::after {
                margin-left: unset;
              }
              &::after {
                margin-right: -0.25rem;
              }
            }
          }
        }
      }
    }
