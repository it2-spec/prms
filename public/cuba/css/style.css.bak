@keyframes hide {
  0% {
    transform: scale(1);
  }

  100% {
    transform: scale(0);
    width: 0;
    height: 0;
    margin: 0;
  }
}

@keyframes show {
  0% {
    transform: scale(0);
    width: 0;
    height: 0;
    margin: 0;
  }

  100% {
    transform: scale(1);
    height: auto;
    width: auto;
  }
}

