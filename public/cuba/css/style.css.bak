          --b: rgba(var(--active-tear), 1);
          --sc: 0;
          --w: 5px;
          --h: 5px;
          --t: 15px;
          --br: 50%;
        }
        &:after {
          --b: rgba(var(--active-tear), 1);
          --sc: 0;
          --w: 5px;
          --h: 5px;
          --t: 15px;
