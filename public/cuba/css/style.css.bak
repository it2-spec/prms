      }
    }
    .blog-bottom-details {
      margin: 1.25rem;
    }
    .blog-bottom-details {
      display: inline-block;
    }
    .blog-bottom-details {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
    .blog-bottom-details {
