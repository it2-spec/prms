    color: rgba(var(--theme-default),1);
  }
  &:hover,
    &:active {
    color: rgb(var(--white),1) !important;
  }
  &:hover,
    &:active {
    border-color: rgba(var(--theme-default),1) !important;
  }
  &:hover,
    &:active {
    background-color: rgba(var(--theme-default),1) !important;
