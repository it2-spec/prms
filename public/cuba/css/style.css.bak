      right: unset;
    }
  }
  .swiper-button-prev {
    left: unset;
  }
  .swiper-button-prev {
    right: 70px;
  }
  .swiper-button-prev {
    [dir="rtl"] & {
      left: 70px;
    }
    [dir="rtl"] & {
      right: unset;
    }
  }
