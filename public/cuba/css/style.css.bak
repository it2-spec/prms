  .animated-timeline {
    .timeline-block {
      &::before {
        left: unset;
      }
      &::before {
        right: 50%;
      }
      .timeline-event {
        &:before {
          right: -27px;
        }
        &:before {
          left: unset;
        }
        &:nth-child(odd) {
          margin-left: unset;
        }
        &:nth-child(odd) {
          margin-right: calc(50% + 20px);
        }
        &:nth-child(even) {
          margin-right: calc(50% - 321px);
        }
        &:nth-child(even) {
          margin-left: unset;
        }
        &:nth-child(even)::before {
          content: var(--tw-content);
          left: unset;
        }
        &:nth-child(even)::before {
          content: var(--tw-content);
          right: calc(100% + 16px);
        }
      }
    }
